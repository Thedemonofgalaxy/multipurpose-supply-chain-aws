# ========================================================
# AWS CloudChain SCM - Configuration Environment
# ========================================================

# App Settings
APP_NAME=AWS CloudChain SCM
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# AWS Cloud Execution Mode:
# 'auto'  : Checks AWS credentials; if absent, uses zero-config local cloud emulation
# 'aws'   : Forces connection to live AWS Cloud (requires keys below)
# 'local' : Forces zero-cost local emulation mode (offline demo)
AWS_MODE=auto

# AWS IAM Credentials (Optional for local mode; required for live AWS)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# Amazon DynamoDB Tables
DYNAMODB_TABLE_INVENTORY=scm-inventory
DYNAMODB_TABLE_ORDERS=scm-orders
DYNAMODB_TABLE_SUPPLIERS=scm-suppliers
DYNAMODB_TABLE_TELEMETRY=scm-telemetry
DYNAMODB_TABLE_AUDIT=scm-audit-logs

# Amazon S3 Bucket
S3_BUCKET_NAME=scm-shipping-manifests-demo

# Amazon SNS Alerts
SNS_TOPIC_ALERTS=scm-critical-alerts
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:scm-critical-alerts
